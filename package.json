{
  "name": "feature-selection-mvp-planning",
  "version": "1.0.0",
  "description": "Automated feature extraction, team voting, and MVP planning system for car rental application",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun build src/feature-extractor/index.ts src/form-generator/index.ts src/google-forms-client/index.ts --outdir dist --target node",
    "test": "bun test",
    "extract-features": "bun run src/feature-extractor/index.ts",
    "generate-form": "bun run src/form-generator/index.ts",
    "google-forms-client": "bun run src/google-forms-client/index.ts",
    "fetch-responses": "bun run scripts/fetch-form-responses.ts"
  },
  "keywords": ["feature-extraction", "mvp-planning", "google-forms", "automation"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.10.0",
    "googleapis": "^128.0.0",
    "gray-matter": "^4.0.3",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "fast-check": "^3.15.0"
  }
}
